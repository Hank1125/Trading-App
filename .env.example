# Local Homebrew Postgres 16 runs on 5433 (5432 is taken by another install on the dev machine).
DATABASE_URL="postgresql://apple@localhost:5433/meta_market?schema=public"
DATABASE_URL_TEST="postgresql://apple@localhost:5433/meta_market_test?schema=public"

# mock = labeled synthetic Siege rounds; live = rounds parsed from uploaded replays.
DATA_MODE="mock"

R6_DISSECT_BIN="./vendor/bin/r6-dissect"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="200"

MIN_SNAPSHOT_ROUNDS="50"
SNAPSHOT_DEBOUNCE_SECONDS="10"

ADMIN_TOKEN="replace-with-a-long-random-local-secret"
