# Shared with the Django/Clash app: same Postgres as docker-compose.yml (localhost:5433, user/pass metamarket).
DATABASE_URL="postgresql+psycopg://metamarket:metamarket@localhost:5433/metamarket"
DATABASE_URL_TEST="postgresql+psycopg://metamarket:metamarket@localhost:5433/metamarket_siege_test"   # disposable; tests wipe it

# replay = real past event (BLAST Major May 2026) on an accelerated demo clock; live = Liquipedia API.
DATA_MODE="replay"

# Liquipedia API terms require a descriptive User-Agent with contact info, and <= 1 request / 2 s.
LIQUIPEDIA_USER_AGENT="MetaMarketHackathon/0.1 (https://github.com/Hank1125/Trading-App; you@example.com)"
LIQUIPEDIA_MIN_INTERVAL_SECONDS="2"
POLL_INTERVAL_SECONDS="300"

ADMIN_TOKEN="replace-with-a-long-random-local-secret"
