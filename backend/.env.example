# Local Homebrew Postgres 16 runs on 5433 (5432 is taken by another install on the dev machine).
DATABASE_URL="postgresql+psycopg://apple@localhost:5433/meta_market"
DATABASE_URL_TEST="postgresql+psycopg://apple@localhost:5433/meta_market_test"

# mock = labeled fixture data; live = Liquipedia API (pro matches).
DATA_MODE="live"

# Liquipedia API terms require a descriptive User-Agent with contact info, and <= 1 request / 2 s.
LIQUIPEDIA_USER_AGENT="MetaMarketHackathon/0.1 (https://github.com/Hank1125/Trading-App; you@example.com)"
LIQUIPEDIA_MIN_INTERVAL_SECONDS="2"
POLL_INTERVAL_SECONDS="300"

ADMIN_TOKEN="replace-with-a-long-random-local-secret"
